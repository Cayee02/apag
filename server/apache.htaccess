Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Compiled HTML must always pass through the content renderer.
  RewriteRule ^(?:index\.html|servicios\.html|nosotros\.html|galeria\.html|contacto\.html|privacidad\.html|404\.html)?$ index.php [END]
  RewriteRule ^(?:admin(?:/)?|media/.*)$ index.php [END]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [END]
</IfModule>

<FilesMatch "\.(?:json|lock|bak|env|log)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(?:html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
